{
  "expo": {
    "name": "Homesika",
    "slug": "homesika",
    "scheme": "homesika",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/homesika-logo.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.homesika.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.homesika.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/homesika-logo.jpg",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Homesika to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Homesika to use your photos so you can show what needs repairing.",
          "cameraPermission": "Allow Homesika to use the camera so you can take photos of repairs and ID.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B2B63",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Homesika to share your location with estate security when you raise an emergency alert."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
