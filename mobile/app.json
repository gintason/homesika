{
  "expo": {
    "name": "Homesika",
    "slug": "homesika",
    "scheme": "homesika",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/homesika-logo.jpg",
    "userInterfaceStyle": "light",
    "ios": { "bundleIdentifier": "com.homesika.app", "supportsTablet": false },
    "android": { "package": "com.homesika.app", "edgeToEdgeEnabled": true },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        { "image": "./assets/homesika-logo.jpg", "imageWidth": 220, "resizeMode": "contain", "backgroundColor": "#FFFFFF" }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
