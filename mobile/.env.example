# Copy to mobile/.env. Public values only (bundled into the app): never put secrets here.
# iOS Simulator: http://localhost:8001 · Android emulator: http://10.0.2.2:8001 · phone: http://<Mac IP>:8001
EXPO_PUBLIC_API_URL=http://localhost:8001

# Optional: links to the published Terms and Privacy Policy, shown on sign-up.
# EXPO_PUBLIC_TERMS_URL=https://homesika.com/terms
# EXPO_PUBLIC_PRIVACY_URL=https://homesika.com/privacy
# Web dashboard address (a guard opens the live security desk from an alert push):
# EXPO_PUBLIC_WEB_URL=https://homesika-staging-web.onrender.com
