# Copy to backend/.env for local development. Never commit .env.
# Values here are placeholders; real secrets live only in your .env or the host's secret manager.

# ---- Django ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
TIME_ZONE=Africa/Lagos
DEFAULT_COUNTRY=NG
DEFAULT_CURRENCY=NGN
LOG_LEVEL=INFO

# ---- Data stores (docker compose provides these) ----------------------------
DATABASE_URL=postgres://homesika:homesika-dev-password@db:5432/homesika
REDIS_URL=redis://redis:6379/0

# ---- Encryption of sensitive columns (AES-256-GCM) --------------------------
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEYS=

# ---- Observability ------------------------------------------------------------
SENTRY_DSN=
ENVIRONMENT=local

# ---- Links in SMS / WhatsApp point at the web app's public pages -------------
WEB_APP_URL=http://localhost:5173

# ---- SMS ----------------------------------------------------------------------
# "mock" logs messages and sends nothing. "termii" sends for real (needs an approved sender ID).
SMS_PROVIDER=mock
TERMII_API_KEY=
TERMII_SENDER_ID=Homesika

# ---- Payments (rent and dues settle straight to the landlord's bank) --------
# Comma-separated, in failover order. "mock" is for development only and is refused in production.
# Use TEST keys (sk_test_..., FLWSECK_TEST-...) until you go live.
PAYMENT_GATEWAYS=mock
PAYMENT_LINK_TTL_HOURS=72
# Homesika's fee per payment: percent, and a cap in kobo (0 = no fee / no cap).
PLATFORM_FEE_PERCENT=0
PLATFORM_FEE_CAP=0
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you set in the Flutterwave dashboard for webhooks.
FLUTTERWAVE_WEBHOOK_HASH=

# ---- Integrations still to come (mocks are used while these are empty) ------
# Phase 2: WHATSAPP_*, ANTHROPIC_API_KEY, ANTHROPIC_MODEL
# Phase 3: VTU provider keys
# Phase 4: ID verification provider keys
