# Copy to backend/.env for local development. Never commit .env.
# Values here are placeholders; real secrets live only in your .env or the host's secret manager.

# ---- Django ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
TIME_ZONE=Africa/Lagos
DEFAULT_COUNTRY=NG
DEFAULT_CURRENCY=NGN
LOG_LEVEL=INFO

# ---- Data stores (docker compose provides these) ----------------------------
DATABASE_URL=postgres://homesika:homesika-dev-password@db:5432/homesika
REDIS_URL=redis://redis:6379/0

# ---- Encryption of sensitive columns (AES-256-GCM) --------------------------
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEYS=

# ---- Observability ------------------------------------------------------------
SENTRY_DSN=
ENVIRONMENT=local

# ---- Links in SMS / WhatsApp point at the web app's public pages -------------
WEB_APP_URL=http://localhost:5173

# ---- SMS ----------------------------------------------------------------------
# "mock" logs messages and sends nothing. "termii" sends for real (needs an approved sender ID).
SMS_PROVIDER=mock
TERMII_API_KEY=
TERMII_SENDER_ID=Homesika

# ---- Payments (rent and dues settle straight to the landlord's bank) --------
# Comma-separated, in failover order. "mock" is for development only and is refused in production.
# Use TEST keys (sk_test_..., FLWSECK_TEST-...) until you go live.
PAYMENT_GATEWAYS=mock
PAYMENT_LINK_TTL_HOURS=72
# Homesika's fee per payment: percent, and a cap in kobo (0 = no fee / no cap).
PLATFORM_FEE_PERCENT=0
PLATFORM_FEE_CAP=0
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you set in the Flutterwave dashboard for webhooks.
FLUTTERWAVE_WEBHOOK_HASH=

# ---- WhatsApp (Meta WhatsApp Cloud API) -----------------------------------------
# "mock" sends nothing (development). "cloud" for real. "off" disables WhatsApp entirely.
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App secret (for the webhook signature) and the verify token you choose when adding the webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved templates per message kind (JSON). Empty = reminders and receipts go by SMS. See docs/WHATSAPP_TEMPLATES.md.
WHATSAPP_TEMPLATES={}
# Escalations that belong to no organization alert this number; shown hours in replies.
SUPPORT_PHONE=
SUPPORT_HOURS=Monday to Saturday, 8am to 6pm (Lagos time)

# ---- AI assistant (Claude) ------------------------------------------------------
# "mock" = a labelled stand-in (development). "anthropic" = Claude; needs ANTHROPIC_API_KEY.
ASSISTANT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_EFFORT_CHAT=medium
ASSISTANT_EFFORT_LISTING=medium
# Spending caps (USD, estimated from token usage).
ASSISTANT_USER_DAILY_CAP_USD=0.50
ASSISTANT_ORG_MONTHLY_CAP_USD=30
ASSISTANT_PLATFORM_DAILY_CAP_USD=25

# ---- Bills: airtime, data, TV, electricity (licensed VTU providers) ----------
# Failover order. "mock" delivers nothing (development) and is refused in production.
BILLS_PROVIDERS=mock
VTUNG_USERNAME=
VTUNG_PASSWORD=
# The account PIN VTU.ng signs webhooks with.
VTUNG_USER_PIN=
# Homesika's fee per order in kobo, by category (10000 = NGN 100). {} = no fees.
BILLS_FEES={"electricity": 10000, "cable_tv": 10000}
BILLS_DATA_MARKUP_PERCENT=0
BILLS_TV_MARKUP_PERCENT=0
# Most a person can spend on bills in 24 hours, in kobo. 0 = no limit (the default).
BILLS_DAILY_LIMIT=0

# ---- File storage for listing photos (S3-compatible, e.g. Cloudflare R2) -------
# Empty = local disk (development only: Render's disk is wiped on every deploy).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_DOMAIN=
# A second bucket with NO public access, for repair photos and ID documents.
S3_PRIVATE_BUCKET=

# ---- Integrations still to come (mocks are used while these are empty) ------
# Phase 3: VTU provider keys
# Phase 4: ID verification provider keys
